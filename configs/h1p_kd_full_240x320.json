{
  "backbone": "mnv3s",
  "pretrained": true,
  "decoupled_head": true,
  "full_train": true,
  "init_from": ["h1p_kd_240x320", "h1p_v2_full_240x320"],
  "input_hw": [240, 320],
  "epochs": 50,
  "lr": 0.0006,
  "box_weight": 1.5,
  "neighbor_weight": 0.25,
  "ema_decay": 0.85,
  "close_mosaic": 15,
  "aug": {
    "mosaic": 0.3
  },
  "act_penalty": {
    "threshold": 16,
    "weight": 0.01
  },
  "kd": {
    "teacher_backbone": "mnv3l",
    "teacher_epochs": 25,
    "hm_weight": 1.5,
    "box_weight": 0.5
  }
}
