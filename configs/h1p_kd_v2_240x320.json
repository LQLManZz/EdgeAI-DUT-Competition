{
  "backbone": "mnv3s",
  "pretrained": true,
  "decoupled_head": true,
  "init_from": "h1p_kd_240x320",
  "input_hw": [240, 320],
  "epochs": 40,
  "lr": 0.0005,
  "box_weight": 1.8,
  "neighbor_weight": 0.3,
  "ema_decay": 0.88,
  "close_mosaic": 15,
  "aug": {
    "mosaic": 0.25
  },
  "act_penalty": {
    "threshold": 16,
    "weight": 0.01
  },
  "kd": {
    "teacher_backbone": "mnv3l",
    "teacher_epochs": 55,
    "hm_weight": 1.5,
    "box_weight": 0.6
  }
}
